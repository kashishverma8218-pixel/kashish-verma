rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // AUTH & ROLE HELPERS
    // -------------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // 4. Admin lookup via admins collection or verified bootstrapped owner email
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'kashishverma8218@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // -------------------------------------------------------------------------
    // COUNTER VALIDATION HELPERS (3. फर्जी Views, Likes और Dislikes रोकने के नियम)
    // -------------------------------------------------------------------------
    function isValidCounterDelta(field, allowDecrement) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]) || (
        request.resource.data[field] is int &&
        (resource.data.get(field, 0) is int || resource.data.get(field, 0) is float) &&
        request.resource.data[field] >= 0 &&
        request.resource.data[field] <= resource.data.get(field, 0) + 1 &&
        (
          (allowDecrement && request.resource.data[field] >= resource.data.get(field, 0) - 1) ||
          (!allowDecrement && request.resource.data[field] >= resource.data.get(field, 0))
        )
      );
    }

    function isValidVideoInteraction() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'dislikes'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'userId'])
        && isValidCounterDelta('views', false)
        && isValidCounterDelta('likes', true)
        && isValidCounterDelta('dislikes', true);
    }

    function isValidReelInteraction() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'commentsCount', 'sharesCount'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'userId'])
        && isValidCounterDelta('views', false)
        && isValidCounterDelta('likes', true)
        && isValidCounterDelta('commentsCount', true)
        && isValidCounterDelta('sharesCount', false);
    }

    function isValidCommentInteraction() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'repliesCount'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'authorName', 'content', 'text'])
        && isValidCounterDelta('likes', true)
        && isValidCounterDelta('dislikes', true)
        && isValidCounterDelta('repliesCount', true);
    }

    // =========================================================================
    // 1. USER PROFILES (PII protected: owner or admin read)
    // =========================================================================
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == request.auth.uid
                    && (!('role' in request.resource.data) || request.resource.data.role in ['user', 'creator']);
      allow update: if (isOwner(uid) && (!('role' in request.resource.data) || ('role' in resource.data && request.resource.data.role == resource.data.role)))
                    || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // =========================================================================
    // 2. VIDEOS (5. Public Query सुरक्षा + 6. पुराने बिना visibility वाले वीडियो संगत)
    // =========================================================================
    match /videos/{videoId} {
      // Single Document (Playback):
      // - पुराने वीडियो जिनमें visibility नहीं है, वे भी चलेंगे
      // - public और unlisted वीडियो कोई भी देख सकता है
      // - private वीडियो केवल असली मालिक या Custom Claim Admin देख सकते हैं
      allow get: if (!('visibility' in resource.data) || resource.data.visibility != 'private')
                 || (signedIn() && resource.data.ownerId == request.auth.uid)
                 || isAdmin();

      // Collection Queries (Home Feed / Search):
      // - केवल वही वीडियो सूची में आएंगे जो public हैं या पुराने हैं (जिनमें visibility फ़ील्ड नहीं है)
      // - मालिक अपने private वीडियो भी query कर सकता है
      // - Admin सभी वीडियो query कर सकता है
      allow list: if (!('visibility' in resource.data) || resource.data.visibility == 'public')
                  || (signedIn() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();

      // Create: केवल लॉगिन यूज़र अपनी UID से वीडियो बना सकता है; प्रारंभिक Views/Likes 0 अनिवार्य
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && (!('views' in request.resource.data) || request.resource.data.views == 0)
                    && (!('likes' in request.resource.data) || request.resource.data.likes == 0)
                    && (!('dislikes' in request.resource.data) || request.resource.data.dislikes == 0);

      // Update:
      // - मालिक metadata बदल सकता है (पर ownerId कभी नहीं बदल सकता)
      // - अन्य यूज़र केवल कड़े सत्यापन (isValidVideoInteraction) से views/likes बदल सकते हैं
      // - Custom Claim Admin पूर्ण नियंत्रण रखता है
      allow update: if (signedIn() && (
                      (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId) ||
                      isValidVideoInteraction()
                    )) || isAdmin();

      // Delete: केवल सत्यापित मालिक या Custom Claim Admin ही वीडियो डिलीट कर सकता है
      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 3. REELS
    // =========================================================================
    match /reels/{reelId} {
      allow get: if !('visibility' in resource.data)
                 || resource.data.visibility != 'private'
                 || (signedIn() && resource.data.ownerId == request.auth.uid)
                 || isAdmin();

      allow list: if !('visibility' in resource.data)
                  || resource.data.visibility == 'public'
                  || (signedIn() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && (!('views' in request.resource.data) || request.resource.data.views == 0)
                    && (!('likes' in request.resource.data) || request.resource.data.likes == 0);

      allow update: if (signedIn() && (
                      (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId) ||
                      isValidReelInteraction()
                    )) || isAdmin();

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 4. COMMENTS
    // =========================================================================
    match /comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && (!('likes' in request.resource.data) || request.resource.data.likes == 0);

      allow update: if (signedIn() && (
                      (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) ||
                      isValidCommentInteraction()
                    )) || isAdmin();

      allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 5. LIKES (3. डुप्लीकेट और फर्जी Like रोकने के लिए Doc ID बाँधना)
    // =========================================================================
    match /likes/{likeId} {
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // likeId अनिवार्य रूप से `${request.auth.uid}_${targetId}` होना चाहिए
      allow create: if signedIn()
                    && isValidId(likeId)
                    && request.resource.data.keys().hasAll(['id', 'userId', 'targetId', 'type', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['id', 'userId', 'targetId', 'targetType', 'type', 'createdAt'])
                    && request.resource.data.id == likeId
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() > 0
                    && request.resource.data.targetId.size() <= 128
                    && (!('targetType' in request.resource.data) || request.resource.data.targetType in ['video', 'reel', 'comment'])
                    && request.resource.data.type in ['like', 'dislike']
                    && request.resource.data.createdAt is int
                    && likeId == request.auth.uid + '_' + request.resource.data.targetId;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['id', 'userId', 'targetId', 'type', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['id', 'userId', 'targetId', 'targetType', 'type', 'createdAt'])
                    && request.resource.data.id == likeId
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.targetId == resource.data.targetId
                    && (!('targetType' in request.resource.data) || request.resource.data.targetType in ['video', 'reel', 'comment'])
                    && request.resource.data.type in ['like', 'dislike']
                    && request.resource.data.createdAt is int
                    && likeId == request.auth.uid + '_' + request.resource.data.targetId;
      allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 6. SUBSCRIPTIONS
    // =========================================================================
    match /subscriptions/{subscriptionId} {
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
                    && isValidId(subscriptionId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.channelId is string
                    && request.resource.data.channelId.size() > 0
                    && request.resource.data.channelId.size() <= 128
                    && subscriptionId == request.auth.uid + '_' + request.resource.data.channelId;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.channelId == resource.data.channelId
                    && subscriptionId == request.auth.uid + '_' + request.resource.data.channelId;
      allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 7. FOLLOWERS (7. Follow Button के लिए 100% सुरक्षित और संगत व्यवस्था)
    // =========================================================================
    match /followers/{followerId} {
      allow get: if signedIn() && (resource == null || resource.data.followerId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.followerId == request.auth.uid || isAdmin());
      // followerId अनिवार्य रूप से `${request.auth.uid}_${creatorId}` होना चाहिए
      allow create: if signedIn()
                    && isValidId(followerId)
                    && request.resource.data.followerId == request.auth.uid
                    && request.resource.data.creatorId is string
                    && request.resource.data.creatorId.size() > 0
                    && request.resource.data.creatorId.size() <= 128
                    && followerId == request.auth.uid + '_' + request.resource.data.creatorId;
      allow update: if signedIn()
                    && resource.data.followerId == request.auth.uid
                    && request.resource.data.followerId == request.auth.uid
                    && request.resource.data.creatorId == resource.data.creatorId
                    && followerId == request.auth.uid + '_' + request.resource.data.creatorId;
      allow delete: if (signedIn() && resource.data.followerId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 8. NOTIFICATIONS (2. केवल अधिकृत प्रेषक ही Notification बना सकता है)
    // =========================================================================
    match /notifications/{notificationId} {
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // प्रेषक (sender) का UID लॉगिन यूज़र से मेल खाना चाहिए; कोई फर्जी नाम से नहीं भेज सकता
      allow create: if (signedIn() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.fromUserId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      )) || isAdmin();

      // केवल प्राप्तकर्ता ही पढ़ सकता है और 'read' मार्क कर सकता है
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 9. WATCH HISTORY
    // =========================================================================
    match /watchHistory/{historyId} {
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 10. PLAYLISTS
    // =========================================================================
    match /playlists/{playlistId} {
      allow read: if resource.data.isPublic == true
                  || resource.data.isPrivate == false
                  || (signedIn() && resource.data.userId == request.auth.uid)
                  || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 11. ANALYTICS
    // =========================================================================
    match /analytics/{analyticsId} {
      allow get: if isAdmin() || (signedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if (signedIn() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 12. REPORTS
    // =========================================================================
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isAdmin() || (signedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 13. CATEGORIES
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 14. SEARCH HISTORY
    // =========================================================================
    match /searchHistory/{searchId} {
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // 15. TEST CONNECTION
    // =========================================================================
    match /test/{docId} {
      allow get: if docId == 'connection' || signedIn();
      allow list: if signedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // DEFAULT DENY CATCH-ALL (9. बिना अनुमति के किसी भी Collection का एक्सेस ब्लॉक)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
