# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Cloud / Firebase Backend Configuration (Non-secret identifiers)
GCP_PROJECT_ID="gen-lang-client-0261415020"
GCS_BUCKET_NAME="gen-lang-client-0261415020.firebasestorage.app"
FIRESTORE_DATABASE_ID="ai-studio-lumentubevideost-c37b5f45-474f-48b4-9ce1-a2efcf683527"
TRANSCODER_LOCATION="asia-northeast1"

# Secret used to sign short-lived HLS playback & upload session tokens on Cloud Run
# Set via Google Cloud Secret Manager or Cloud Run env vars in production (never commit real secrets)
PLAYBACK_TOKEN_SECRET=""

# Optional comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=""
